{
  "name": "keeper",
  "private": true,
  "version": "0.1.0",
  "description": "Cull a whole photo shoot in your browser: Keeper groups bursts, checks focus and blinks, and picks the best frame of every moment.",
  "type": "module",
  "license": "MIT",
  "author": "Aadharsh Arunn",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/copy-mediapipe.mjs && vite",
    "build": "node scripts/copy-mediapipe.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "node scripts/eval.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@mediapipe/tasks-vision": "1.1.1",
    "@tanstack/react-virtual": "3.14.21",
    "client-zip": "2.5.1",
    "idb": "8.0.4",
    "libheif-js": "1.23.2",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  }
}
